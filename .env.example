# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- LLM (any OpenAI-compatible /chat/completions endpoint with tool calling) ---
# Groq example; see https://console.groq.com/docs/models for currently served models.
KSERVE_URL=https://api.groq.com/openai/v1/chat/completions
MODEL=openai/gpt-oss-20b
LLM_API_KEY=replace-me
# Output token budgets. Free tiers (~8k tokens/min) need small values.
LLM_MAX_TOKENS=600
LLM_FOLLOWUP_MAX_TOKENS=500
LLM_MAX_RETRY_WAIT=10
LLM_RATE_LIMIT_RETRIES=2
# Bring-your-own-key from the widget (X-LLM-API-Key header). On a public deployment set
# REQUIRE_CLIENT_API_KEY=true so visitors must use their own key, never LLM_API_KEY.
ALLOW_CLIENT_API_KEYS=true
REQUIRE_CLIENT_API_KEY=false

# --- Retrieval ---
# Ingestion and the API MUST use the same embedding model (vector dimension must match).
# all-MiniLM-L6-v2 (384-d) is fast on CPU; BAAI/bge-base-en-v1.5 (768-d) is the code default.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
DOCS_COLLECTION=docs_collection
CODE_COLLECTION=code_collection

# --- API ---
PORT=8000
THREAD_TTL_SECONDS=3600
THREAD_MAX_MESSAGES=16
TOKENIZERS_PARALLELISM=false
